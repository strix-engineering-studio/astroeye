generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
}

enum RoleKey {
    SUPER_ADMIN
    ADMIN
    EDITOR
    PRODUCT_OWNER
    SALES
    PARTNER
    CLIENT
}

enum ProductStatus {
    IDEA
    MVP
    BETA
    PRODUCTION
    GROWTH
    ARCHIVED
}

enum PublicationStatus {
    DRAFT
    REVIEW
    PUBLISHED
    ARCHIVED
}

enum PartnerType {
    AGENCY
    CONSULTANT
    REFERRAL
    TECHNOLOGY
    SYSTEM_INTEGRATOR
}

enum ContactStatus {
    NEW
    TRIAGED
    CONTACTED
    CONVERTED
    CLOSED
}

model User {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    name      String?
    email     String    @unique
    avatarUrl String?
    roles     RoleKey[]
    metadata  Json?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model Role {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    key         RoleKey  @unique
    name        String
    permissions String[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Product {
    id               String        @id @default(auto()) @map("_id") @db.ObjectId
    name             String
    slug             String        @unique
    shortDescription String?
    description      String?
    status           ProductStatus @default(IDEA)
    category         String?
    website          String?
    github           String?
    architecture     String?
    features         String[]
    techStack        String[]
    imageIds         String[]      @db.ObjectId
    seoTitle         String?
    seoDescription   String?
    createdAt        DateTime      @default(now())
    updatedAt        DateTime      @updatedAt
    publishedById    String?       @db.ObjectId
    publishedAt      DateTime?
    deletedAt        DateTime?

    @@index([status, category])
    @@index([createdAt])
}

model CaseStudy {
    id             String            @id @default(auto()) @map("_id") @db.ObjectId
    title          String
    slug           String            @unique
    client         String
    industry       String?
    problem        String?
    solution       String?
    architecture   String?
    implementation String?
    outcome        Json?
    technologies   String[]
    galleryIds     String[]          @db.ObjectId
    seoTitle       String?
    seoDescription String?
    status         PublicationStatus @default(DRAFT)
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt
    publishedAt    DateTime?
    deletedAt      DateTime?

    @@index([status, createdAt])
}

model OpenSourceProject {
    id               String    @id @default(auto()) @map("_id") @db.ObjectId
    name             String
    slug             String    @unique
    githubUrl        String
    documentationUrl String?
    description      String?
    category         String?
    stars            Int?
    downloads        Int?
    technologies     String[]
    imageIds         String[]  @db.ObjectId
    seoTitle         String?
    seoDescription   String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    deletedAt        DateTime?
}

model Partner {
    id               String      @id @default(auto()) @map("_id") @db.ObjectId
    name             String
    company          String?
    email            String?
    phone            String?
    website          String?
    type             PartnerType
    status           String?
    notes            String?
    projectsReferred String[]
    createdAt        DateTime    @default(now())
    updatedAt        DateTime    @updatedAt
    deletedAt        DateTime?

    @@index([type, status])
}

model ContactRequest {
    id         String        @id @default(auto()) @map("_id") @db.ObjectId
    name       String
    email      String
    company    String?
    category   String?
    budget     String?
    timeline   String?
    brief      String?
    source     String?
    status     ContactStatus @default(NEW)
    assignedTo String?       @db.ObjectId
    notes      String?
    createdAt  DateTime      @default(now())
    updatedAt  DateTime      @updatedAt
    deletedAt  DateTime?

    @@index([status, createdAt])
    @@index([assignedTo])
}

model MediaAsset {
    id         String    @id @default(auto()) @map("_id") @db.ObjectId
    url        String
    filename   String?
    mimeType   String?
    width      Int?
    height     Int?
    altText    String?
    meta       Json?
    uploadedBy String?   @db.ObjectId
    createdAt  DateTime  @default(now())
    deletedAt  DateTime?

    @@index([filename])
}

model Setting {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    key         String   @unique
    value       Json
    environment String?
    updatedAt   DateTime @updatedAt
}

model AuditLog {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    actorId     String?  @db.ObjectId
    action      String
    subjectType String
    subjectId   String?
    meta        Json?
    timestamp   DateTime @default(now())

    @@index([actorId, timestamp])
}
